<UserControl x:Class="DiskTrim.Pages.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Duplicates" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="Identical copies of the same file (same content, any name), searched in the scanned files. One copy of each file is always kept." />
            <WrapPanel Style="{StaticResource Toolbar}">
                <TextBlock Text="Ignore files smaller than" VerticalAlignment="Center" Margin="0,0,8,6" />
                <ComboBox x:Name="MinSizeBox" MinWidth="100" Margin="0,0,16,6" />
                <TextBlock Text="Keep" VerticalAlignment="Center" Margin="0,0,8,6" />
                <ComboBox x:Name="KeepBox" MinWidth="220" Margin="0,0,16,6" SelectionChanged="Keep_Changed" />
                <Button Content="Find duplicates" Style="{DynamicResource AccentButtonStyle}" Click="Find_Click" Margin="0,0,0,6" />
            </WrapPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Open in File Explorer" Click="Open_Click" Margin="0,0,8,0" />
                <Button Content="Move ticked copies to Recycle Bin" Style="{DynamicResource AccentButtonStyle}" Click="Recycle_Click" />
            </StackPanel>
            <TextBlock x:Name="Summary" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="Choose the options above and click Find duplicates." />
        </DockPanel>

        <Grid>
        <Border x:Name="EmptyState" Style="{StaticResource Card}" Padding="40" Margin="0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="EmptyText" Text="No results yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock x:Name="EmptyHint" Text="Choose the options above and click Find duplicates." Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Border>
        <DataGrid x:Name="Grid" Visibility="Collapsed" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,12,0,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Remove" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Marked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" MinWidth="0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn ElementStyle="{StaticResource WrapCell}" Header="Modified" Binding="{Binding ModifiedText}" IsReadOnly="True" Width="140" />
                <DataGridTextColumn ElementStyle="{StaticResource WrapCell}" Header="Size" Binding="{Binding SizeText}" IsReadOnly="True" Width="90" />
                <DataGridTextColumn ElementStyle="{StaticResource WrapCell}" Header="Path" Binding="{Binding Path}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
