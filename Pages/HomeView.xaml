<UserControl x:Class="DiskTrim.Pages.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Caps" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,8,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Home" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="MachineText" Style="{StaticResource Muted}" Margin="0,0,0,16" />

            <ItemsControl x:Name="DriveList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="290" Margin="0,0,12,12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                           Margin="0,0,14,0" VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,10,0,8"
                                                 Foreground="{Binding BarBrush}" />
                                    <TextBlock Text="{Binding FreeText}" FontSize="12" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- Safe to free -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0">
                    <StackPanel>
                        <TextBlock Text="SAFE TO FREE RIGHT NOW" Style="{StaticResource Caps}" />
                        <TextBlock x:Name="SafeBytes" Text="Measuring…" FontSize="34" FontWeight="SemiBold" />
                        <TextBlock x:Name="SafeDetail" TextWrapping="Wrap" Margin="0,4,0,14"
                                   Text="Temporary files and caches that Windows and your apps rebuild by themselves. Your own files are never touched." />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CleanSafeButton" Click="CleanSafe_Click" Margin="0,0,8,0" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" />
                                    <TextBlock Text="Clean safe items" />
                                </StackPanel>
                            </Button>
                            <Button Content="Review in Cleanup" Click="ReviewCleanup_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Drive scan -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20" Margin="0">
                    <StackPanel>
                        <TextBlock Text="DRIVE SCAN" Style="{StaticResource Caps}" />
                        <TextBlock x:Name="ScanTitle" Text="Not scanned yet" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="ScanDetail" TextWrapping="Wrap" Margin="0,6,0,14"
                                   Text="Scan a drive to see what uses the space and get personalised recommendations." />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ScanDriveButton" Click="ScanDrive_Click" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" />
                                    <TextBlock x:Name="ScanDriveText" Text="Scan C:" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenExplorerButton" Content="Open Explorer" Click="OpenExplorer_Click" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <DockPanel Margin="0,20,0,10">
                <Button DockPanel.Dock="Right" Click="Refresh_Click" VerticalAlignment="Bottom" ToolTip="Measure again">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Recommendations" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                    <TextBlock x:Name="RecHint" Text="Biggest wins first." Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>

            <ItemsControl x:Name="RecList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,0,10,2" />
                                        <Border Style="{StaticResource Badge}" DataContext="{Binding Level}" Margin="0,0,0,2">
                                            <TextBlock Style="{StaticResource BadgeText}" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="17" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Button Grid.Column="2" Content="{Binding ActionLabel}" Tag="{Binding}" Click="Action_Click"
                                        MinWidth="130" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
