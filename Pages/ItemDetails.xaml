<UserControl x:Class="DiskTrim.Pages.ItemDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <Grid>
            <TextBlock x:Name="Placeholder" Style="{StaticResource Muted}" Text="Select a folder or file to see what it is and whether it is safe to delete." />
            <StackPanel x:Name="Panel" Visibility="Collapsed">
                <TextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="PathText" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,12" />
                <TextBlock x:Name="SizeText" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="CountText" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                <Border x:Name="Badge" Style="{StaticResource Badge}">
                    <TextBlock Style="{StaticResource BadgeText}" />
                </Border>
                <TextBlock x:Name="VerdictTitle" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap" />
                <TextBlock x:Name="ReasonText" TextWrapping="Wrap" />
                <TextBlock x:Name="ImpactText" Style="{StaticResource Muted}" Margin="0,8,0,14" />
                <WrapPanel>
                    <WrapPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Margin" Value="0,0,6,6" />
                        </Style>
                    </WrapPanel.Resources>
                    <Button Content="Open in File Explorer" Click="Open_Click" />
                    <Button Content="Copy path" Click="Copy_Click" />
                    <Button Content="Is it in use?" Click="InUse_Click" />
                    <Button x:Name="ExplorerButton" Content="Show in Explorer" Click="Explorer_Click" />
                    <Button x:Name="TreemapButton" Content="Show in Treemap" Click="Treemap_Click" />
                    <Button Content="Move to another drive…" Click="Move_Click" />
                    <Button Content="Move to Recycle Bin" Click="Recycle_Click" />
                </WrapPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
