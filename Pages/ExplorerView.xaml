<UserControl x:Class="DiskTrim.Pages.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiskTrim.Pages">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="370" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
            <TextBlock Text="Explorer" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="Hint" Style="{StaticResource Muted}"
                       Text="Folders and files by size. Sizes fill in when the scan finishes. Right-click for actions." />
            <DockPanel Margin="0,10,0,0">
                <WrapPanel x:Name="Legend" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
                <Grid MaxWidth="460" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchBox" MinWidth="320" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"
                             ToolTip="Find a file or folder in this scan by name — for example invoice, or *.iso" Padding="30,6,30,6" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" IsHitTestVisible="False"
                               Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SearchPlaceholder" Text="Search this scan (name, or *.iso)" IsHitTestVisible="False"
                               Margin="32,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </DockPanel>
        </StackPanel>

        <!-- Search results replace the tree while something is typed. -->
        <Border x:Name="ResultsCard" Grid.Row="1" Style="{StaticResource Card}" Padding="4" Margin="0" Visibility="Collapsed">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="12,8,8,6">
                    <Button DockPanel.Dock="Right" Content="Back to the tree" Click="ClearSearch_Click" />
                    <TextBlock x:Name="ResultsSummary" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="Results" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="Results_SelectionChanged" MouseDoubleClick="Results_MouseDoubleClick" KeyDown="Results_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Folder}" Style="{StaticResource Muted}" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Margin="12,0,0,0" VerticalAlignment="Top" />
                                <Ellipse Grid.Column="3" Width="10" Height="10" Margin="12,5,4,0" VerticalAlignment="Top"
                                         Fill="{Binding Level, Converter={StaticResource LevelForeground}}"
                                         ToolTip="{Binding Level, Converter={StaticResource LevelText}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border x:Name="TreeCard" Grid.Row="1" Style="{StaticResource Card}" Padding="4" Margin="0">
            <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectedItemChanged="Tree_SelectedItemChanged"
                      PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type local:FolderVM}" ItemsSource="{Binding Children}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" ToolTip="{Binding Path}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" TextAlignment="Right" VerticalAlignment="Center" />
                            <Border Grid.Column="3" Height="6" Width="70" CornerRadius="3" Margin="10,0,0,0" HorizontalAlignment="Left"
                                    Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBoolToVisibility}}">
                                <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="3"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Border>
                            <TextBlock Grid.Column="4" Text="{Binding ShareText}" TextAlignment="Right" VerticalAlignment="Center"
                                       Style="{StaticResource Muted}" FontSize="12" />
                            <Ellipse Grid.Column="5" Width="10" Height="10" Margin="12,0,4,0" VerticalAlignment="Center"
                                     Fill="{Binding Level, Converter={StaticResource LevelForeground}}"
                                     ToolTip="{Binding Level, Converter={StaticResource LevelText}}"
                                     Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
            <local:ItemDetails x:Name="Details" />
        </ScrollViewer>
    </Grid>
</UserControl>
