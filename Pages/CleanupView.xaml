<UserControl x:Class="DiskTrim.Pages.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Cleanup" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="Temporary files and caches Windows and your apps rebuild by themselves. Files in use are skipped and every deleted file is logged." />
            <DockPanel Margin="0,12,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Measure again" Click="Measure_Click" Margin="0,0,8,0" />
                    <Button Content="Select safe items" Click="SelectSafe_Click" Margin="0,0,8,0" />
                    <Button Content="Clean selected" Style="{DynamicResource AccentButtonStyle}" Click="Clean_Click" MinWidth="130" />
                </StackPanel>
                <TextBlock x:Name="Summary" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemList" Margin="0,0,8,0">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="0,12,0,8" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="210" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}"
                                          VerticalAlignment="Top" Margin="0,0,4,0" MinWidth="0" />
                                <StackPanel Grid.Column="1">
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,0,10,2" />
                                        <Border Style="{StaticResource Badge}" DataContext="{Binding Level}" Margin="0,0,0,2">
                                            <TextBlock Style="{StaticResource BadgeText}" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,2" />
                                    <TextBlock Text="{Binding ImpactText}" Style="{StaticResource Muted}" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="15"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" TextWrapping="Wrap"
                                           TextAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
