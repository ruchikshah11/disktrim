<UserControl x:Class="DiskTrim.Pages.TypesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
            <TextBlock Text="File types" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="Hint" Style="{StaticResource Muted}" Text="Scan a drive first." />
        </StackPanel>

        <ListBox x:Name="Categories" Grid.Row="1" SelectionChanged="Categories_SelectionChanged" Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" FontSize="12" />
                        </StackPanel>
                        <Border Grid.Column="1" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,10,0"
                                Background="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="5" Background="{Binding Brush}" />
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="1" Grid.Column="1" Margin="16,0,0,0">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="Show largest files" Click="ShowFiles_Click" />
                <TextBlock x:Name="ExtSummary" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            </DockPanel>
            <DataGrid x:Name="Extensions" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="None" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource WrapCell}" Header="Extension" Binding="{Binding Extension}" Width="120" />
                    <DataGridTextColumn ElementStyle="{StaticResource WrapCell}" Header="Type" Binding="{Binding Category}" Width="150" />
                    <DataGridTextColumn ElementStyle="{StaticResource WrapCell}" Header="Size" Binding="{Binding SizeText}" SortMemberPath="Bytes" Width="100" />
                    <DataGridTextColumn ElementStyle="{StaticResource WrapCell}" Header="Share" Binding="{Binding ShareText}" SortMemberPath="Bytes" Width="80" />
                    <DataGridTextColumn ElementStyle="{StaticResource WrapCell}" Header="Files" Binding="{Binding CountText}" SortMemberPath="Count" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
