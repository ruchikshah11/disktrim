<Window x:Class="DiskTrim.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskTrim Setup" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/DiskTrim.png" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="28,24,28,22">
        <!-- Header -->
        <DockPanel Margin="0,0,0,18">
            <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/DiskTrim.png" Width="52" Height="52"
                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top" Margin="0,2,16,0" />
            <StackPanel>
                <TextBlock x:Name="HeaderText" Text="Install DiskTrim" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Find what fills your disk and free space safely." Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Step 1: options -->
        <StackPanel x:Name="OptionsPanel">
            <Border x:Name="UpdateNote" Style="{StaticResource Card}" Padding="14,10" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock x:Name="UpdateText" TextWrapping="Wrap" />
            </Border>
            <CheckBox x:Name="DesktopBox" Content="Create a desktop shortcut" IsChecked="True" Margin="0,0,0,10" />
            <CheckBox x:Name="PathBox" IsChecked="True" Margin="0,0,0,10">
                <TextBlock TextWrapping="Wrap" Text="Add DiskTrim to PATH (use 'DiskTrim' commands in any terminal)" />
            </CheckBox>
            <CheckBox x:Name="AllUsersBox" Checked="AllUsers_Changed" Unchecked="AllUsers_Changed" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" Margin="0,2,6,0" />
                    <TextBlock TextWrapping="Wrap" Text="Install for all users of this PC (asks for administrator rights)" />
                </StackPanel>
            </CheckBox>
            <TextBlock Text="Install location" FontWeight="SemiBold" />
            <TextBlock x:Name="LocationText" Style="{StaticResource Muted}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Step 2: progress -->
        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
            <TextBlock x:Name="ProgressText" Text="Installing…" TextWrapping="Wrap" Margin="0,0,0,10" />
            <ProgressBar IsIndeterminate="True" Height="4" />
        </StackPanel>

        <!-- Step 3: done -->
        <StackPanel x:Name="DonePanel" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="18" Margin="0,2,8,0" x:Name="DoneIcon" />
                <TextBlock x:Name="DoneTitle" Text="DiskTrim is installed." FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock x:Name="DoneText" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,12" />
            <CheckBox x:Name="LaunchBox" Content="Launch DiskTrim now" IsChecked="True" />
        </StackPanel>

        <!-- Buttons -->
        <DockPanel Margin="0,24,0,0">
        <Button x:Name="PortableButton" DockPanel.Dock="Left" Content="Run without installing" Click="Portable_Click"
                ToolTip="Use DiskTrim from this file without installing it (e.g. from a USB stick)" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="MainButton" Content="Install" MinWidth="110" Style="{DynamicResource AccentButtonStyle}" Click="Main_Click" />
        </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
