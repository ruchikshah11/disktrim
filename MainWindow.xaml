<Window x:Class="DiskTrim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskTrim" Width="1320" Height="860" MinWidth="980" MinHeight="600"
        Icon="pack://application:,,,/Assets/DiskTrim.png"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Sidebar item: subtle fill when selected or hovered, accent bar on the left when selected. -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="5" Background="Transparent" Padding="12,9">
                            <Grid>
                                <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                        Margin="-12,0,0,0" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,8,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Margin="8,10,8,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8,0,18">
                <Image Source="pack://application:,,,/Assets/DiskTrim.png" Width="34" Height="34" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DiskTrim" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Disk analyzer &amp; safe cleanup" FontSize="12" Style="{StaticResource Muted}" />
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="4,0">
                <Button x:Name="AdminButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Admin_Click" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA18;" Style="{StaticResource IconText}" Margin="2,1,10,0" />
                        <TextBlock Text="Run as administrator" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" FontSize="12" Margin="4,0" />
            </StackPanel>

            <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" SelectionChanged="Nav_SelectionChanged"
                     ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                       FontSize="16" Width="30" VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" CornerRadius="8" Padding="6,0,6,1" Margin="6,0,0,0"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"
                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Badge}" FontSize="11"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="14" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Content -->
        <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8,0,0,0">
            <DockPanel>
                <!-- Top bar -->
                <DockPanel DockPanel.Dock="Top" Margin="24,16,24,0" LastChildFill="False">
                    <ComboBox x:Name="PathBox" DockPanel.Dock="Left" Width="300" IsEditable="True" VerticalAlignment="Center"
                              KeyDown="PathBox_KeyDown" ToolTip="Folder to analyse" />
                    <Button DockPanel.Dock="Left" Margin="6,0,0,0" Click="Browse_Click" ToolTip="Choose a folder…" Padding="10,6">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                    </Button>
                    <Grid DockPanel.Dock="Left" Margin="8,0,0,0">
                        <Button x:Name="ScanButton" Style="{DynamicResource AccentButtonStyle}" Click="Scan_Click" MinWidth="84"
                                Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" />
                                <TextBlock Text="Scan" />
                            </StackPanel>
                        </Button>
                        <Button Click="Stop_Click" MinWidth="84"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" Style="{StaticResource IconText}" />
                                <TextBlock Text="Stop" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Button DockPanel.Dock="Right" Click="Report_Click" ToolTip="Save an HTML report">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" Style="{StaticResource IconText}" />
                            <TextBlock Text="Report" />
                        </StackPanel>
                    </Button>
                </DockPanel>

                <!-- Status line -->
                <DockPanel DockPanel.Dock="Bottom" Margin="24,6,24,10">
                    <ProgressBar DockPanel.Dock="Right" Width="180" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"
                               TextWrapping="Wrap" FontSize="12" Margin="0,0,16,0" />
                </DockPanel>

                <ContentControl x:Name="PageHost" Margin="24,16,24,4" Focusable="False" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
